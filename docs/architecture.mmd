flowchart TB
    subgraph UI ["一. 前端"]
        User["USER  用户"]
    end

    subgraph Hub ["二. NotificationHub :8000"]
        SSE["/session/query SSE"]
        Notify["/notify"]
        WS["/ws WebSocket"]
        MemAPI["/memory/*"]
    end

    subgraph Agent ["三. Agent  (LangGraph ReAct)"]
        direction TB
        Graph["graph_thinking.py"]
        Tools["TOOLS  工具集"]
        CoreMem["CoreBlock 热记忆"]
        MemAgent["Memory Agent"]
    end

    subgraph HotMem ["四. 热记忆层  HOT"]
        CoreBlock["CoreBlock  task · error · conclusion"]
        Pending["PendingCache"]
    end

    subgraph ColdMem ["五. 冷记忆层  COLD"]
        ChromaDB["ChromaDB  事实 + 摘要"]
        SQLite["SQLite  会话 + 任务"]
    end

    subgraph SkillSys ["六. SKILL 系统"]
        SkillFiles["skills/*.md"]
    end

    subgraph Devices ["七. 设备服务"]
        PDH["PDH-Locking  :8001"]
        PNA["PNA  :8002"]
    end

    %% === 主数据流 ===
    User -->|"SSE"| SSE
    SSE ==>|"① invoke"| Graph
    Graph ==>|"② tool_call"| Tools
    WS ==>|"③ result"| Graph

    %% === 工具 → 存储 ===
    Tools --> CoreMem
    Tools --> ChromaDB
    Tools --> Pending
    Tools --> SkillFiles

    %% === Memory Agent drain ===
    MemAgent -.->|"drain"| Pending
    MemAgent -.->|"write"| CoreMem
    MemAgent -.->|"embed"| ChromaDB

    %% === 设备通知 ===
    PDH -->|"task_done"| Notify
    PNA -->|"task_done"| Notify
    Notify --> WS

    %% === 视觉强调：主线节点橙边橙字 ===
    classDef primary fill:#fff7ed,stroke:#c2410c,stroke-width:2.4px,color:#c2410c
    class User,SSE,Graph,Tools primary
