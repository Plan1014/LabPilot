# ===== Embedding model (offline cache) =====
# sentence_transformers 默认每次 import 都会 HEAD huggingface.co 检查模型
# 修订版本，已缓存也会卡住。设 1 = 纯本地；想重新下载时设 0。
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ===== LLM provider =====
# 默认走 Anthropic；只要 OPENAI_API_KEY 存在且 ANTHROPIC_API_KEY 为空，
# LabPilot 会自动起一个 LiteLLM Proxy 把 Anthropic 协议翻译成
# OpenAI 兼容协议（DeepSeek/Qwen/GLM/Ollama/vLLM 都行）。
# 在两个 key 都设置时，设 LITELLM_AUTOSTART=true 强制走 Proxy。

# ----- Anthropic 直连（默认）-----
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=                  # 留空走官方；自托管兼容网关也填这里
MODEL_ID=claude-sonnet-4-20250514

# ----- OpenAI 兼容（直连 ChatOpenAI，无本地 proxy）-----
# 本地 Ollama（已验证支持工具调用）:
# OPENAI_API_KEY=ollama
# LITELLM_MODEL=qwen3:8b              # 模型名,前缀 openai/ / anthropic/ 等会被自动剥掉
# LITELLM_MODEL_API_BASE=http://127.0.0.1:11434/v1
#
# 云端 OpenAI 兼容网关（硅基流动等）—— 模型名必须是网关上真实存在的那个:
# LITELLM_MODEL_API_BASE=https://api.siliconflow.cn/v1
# LITELLM_MODEL_API_KEY=sk-...        # 留空则复用 OPENAI_API_KEY
# LITELLM_AUTOSTART=true              # 仅在双 key 都设置时生效,强制走 OpenAI 模式

# ===== 工具鉴权判官（可选）=====
# L2 灰名单的判官模型 —— 独立于主模型，小模型就够，thinking 已关、强制 JSON 输出。
# 不配 = 降级模式：所有需要判官的调用一律转人工审批（fail-closed，绝不默认放行）。
# 判官调不通（超时/报错/JSON 解析失败）同样转人工；连续失败 3 次后直接转人工，不再重试。
# AUTHZ_MODEL_ID=qwen3:8b
# AUTHZ_FALLBACK_MODEL_ID=              # 可选：主模型调不通时的备用判官模型；仍不会回落到主模型
# 上面两个模型名走 OpenAI 兼容协议，复用 OPENAI_API_KEY / LITELLM_MODEL_API_BASE。
# 审批模式（auto / manual）在前端输入栏左下角切换，不用改这里 —— 这里的模型
# 只管 auto 模式下判官的那一票。

# ===== NotificationHub (port 8000) =====
NOTIFICATION_HUB_PORT=8000
NOTIFICATION_HUB_ENABLED=true

# ===== Session storage (SQLite via session_manager.py) =====
# SESSION_TTL_DAYS=30          # auto-delete sessions older than N days (default: 30)
# TOKEN_THRESHOLD=100000       # trigger auto_compact when session exceeds N tokens (default: 100000)

# ===== Memory injection =====
# MEMORY_RELEVANCE_THRESHOLD=0.45   # 自动注入记忆的相关性门槛（cosine distance，越小越相关；
#                                   # 超过门槛的记忆不注入提示词。0.45 是实测分界：
#                                   # 真相关 ~0.36，噪音 ~0.62+。调大=注入更多，调小=更严）

# ===== 调试 =====
# PROMPT_DEBUG=1              # 打开后，每轮都把「实际发给模型的完整输入」打印到后端终端
#                             # （REPL 与 HTTP 两条路都打）。不开也能用调试接口：
#                             #   POST /debug/prompt      给一条 query，现场拼一次（不调模型）
#                             #   GET  /session/{id}/prompt  按已有会话复盘

