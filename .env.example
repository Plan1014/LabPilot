# ===== LLM provider =====
# 默认走 Anthropic；只要 OPENAI_API_KEY 存在且 ANTHROPIC_API_KEY 为空，
# LabPilot 会自动起一个 LiteLLM Proxy 把 Anthropic 协议翻译成
# OpenAI 兼容协议（DeepSeek/Qwen/GLM/Ollama/vLLM 都行）。
# 在两个 key 都设置时，设 LITELLM_AUTOSTART=true 强制走 Proxy。

# ----- Anthropic 直连（默认）-----
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=                  # 留空走官方；自托管兼容网关也填这里
MODEL_ID=claude-sonnet-4-20250514

# ----- OpenAI 兼容（LiteLLM Proxy 模式）-----
# OPENAI_API_KEY=sk-...
# LITELLM_MODEL=openai/qwen2.5-14b-instruct
# LITELLM_MODEL_API_BASE=https://api.siliconflow.cn/v1
# LITELLM_MODEL_API_KEY=sk-...        # 留空则复用 OPENAI_API_KEY
# LITELLM_PROXY_PORT=4000             # 本地 LiteLLM 监听端口
# LITELLM_AUTOSTART=true              # false = 假设你已经在外部起了 proxy
# LITELLM_HOST=127.0.0.1
# LITELLM_STARTUP_TIMEOUT=30          # 等待 proxy 就绪的最大秒数

# ===== NotificationHub (port 8000) =====
NOTIFICATION_HUB_PORT=8000
NOTIFICATION_HUB_ENABLED=true

# ===== Session storage (SQLite via session_manager.py) =====
# SESSION_TTL_DAYS=30          # auto-delete sessions older than N days (default: 30)
# TOKEN_THRESHOLD=100000       # trigger auto_compact when session exceeds N tokens (default: 100000)
